# CDB MQTT Message Broker environment configuration
#
# Copy to ~/.config/cdb-mqtt/cdb-mqtt.env and customize. systemd does not expand
# ~ or %h in this file, so use absolute paths. Empty values are ignored.

# MQTT broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=cdb-mqtt-client
MQTT_USERNAME=
MQTT_PASSWORD=

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Handler plugins and their YAML configuration
CDB_HANDLERS_DIR=/home/cdb/.config/cdb-mqtt/handlers
CDB_CONFIG=/home/cdb/.config/cdb-mqtt/config.yaml

# CDB API (optional; requires the componentdb-api extra). Defaults to global.api_url
# or global.cdb_url from CDB_CONFIG.
CDB_API_URL=
CDB_API_KEY=

# Single-instance lock file
CDB_LOCK_FILE=/tmp/cdb-mqtt.lock
